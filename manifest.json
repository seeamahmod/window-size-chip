{
  "manifest_version": 3,
  "name": "Window Size Chip",
  "version": "1.3.0",
  "author": "Seeam Ahmod",
  "description": "Shows the live width × height of your browser window, resizes it to exact desktop sizes and previews pages in real phone and tablet frames.",
  "permissions": ["storage", "tabs", "debugger", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Window size",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
