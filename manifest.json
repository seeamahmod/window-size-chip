{
  "manifest_version": 3,
  "name": "Window Size Chip",
  "version": "1.2.0",
  "author": "Seeam Ahmod",
  "description": "Shows the live width × height of your browser window and resizes it to common desktop, tablet and mobile sizes.",
  "permissions": ["storage", "tabs", "debugger"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Window size",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
